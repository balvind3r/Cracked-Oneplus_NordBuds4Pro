#!/bin/bash
# Wrapper that launches NordBuds.app via LaunchServices so the bundle
# (not Terminal) is the responsible TCC process, then prints its log.
#
# `open -W` blocks until the app exits; the app exits within ~1-2s once the
# earbuds ACK the command. We deliberately do NOT `tail -F` — macOS/BSD tail
# has no --pid option, so a follow would never terminate and the wrapper
# (and every Raycast invocation) would hang forever.
set -e

cmd="${1:-help}"
here="$(cd "$(dirname "$0")" && pwd)"
app="$here/NordBuds.app"
log="$HOME/Library/Logs/NordBuds.log"

mkdir -p "$(dirname "$log")"
: > "$log"

# Launch the bundle and wait for it to finish, capturing its stdio.
open -W -n -a "$app" --stdout "$log" --stderr "$log" --args "$cmd"

# Surface the result to whoever called us (terminal / Raycast HUD).
cat "$log"
