#!/bin/bash
# Wrapper that launches NordBuds.app via LaunchServices so the bundle
# (not Terminal) is the responsible TCC process. Streams the bundle's
# log output back to this terminal.
set -e

cmd="${1:-help}"
here="$(cd "$(dirname "$0")" && pwd)"
app="$here/NordBuds.app"
log="$HOME/Library/Logs/NordBuds.log"

mkdir -p "$(dirname "$log")"
: > "$log"

# Launch the bundle, redirecting its stdio to the log file.
open -W -n -a "$app" --stdout "$log" --stderr "$log" --args "$cmd" &
open_pid=$!

# Tail the log until `open` returns.
tail -n +1 -F "$log" --pid "$open_pid" 2>/dev/null
wait "$open_pid" 2>/dev/null || true
